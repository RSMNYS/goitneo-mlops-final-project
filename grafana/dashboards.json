{
  "dashboard": {
    "id": null,
    "uid": "inference-api-dashboard",
    "title": "Inference API Dashboard",
    "tags": ["mlops", "inference"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Requests per Minute",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(inference_requests_total[1m]) * 60",
            "legendFormat": "{{endpoint}} - {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqpm"
          }
        }
      },
      {
        "id": 2,
        "title": "Request Latency (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(inference_request_latency_seconds_bucket[5m]))",
            "legendFormat": "p95 latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(inference_request_latency_seconds_bucket[5m]))",
            "legendFormat": "p50 latency",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 3,
        "title": "Drift Alerts (Total)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "drift_detected_total",
            "legendFormat": "Drift Events",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 20 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Drift Rate (per minute)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
        "targets": [
          {
            "expr": "rate(drift_detected_total[1m]) * 60",
            "legendFormat": "Drift/min",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Total Requests",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "inference_requests_total",
            "legendFormat": "{{endpoint}} - {{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Average Latency",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
        "targets": [
          {
            "expr": "rate(inference_request_latency_seconds_sum[5m]) / rate(inference_request_latency_seconds_count[5m])",
            "legendFormat": "avg latency",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.5 },
                { "color": "red", "value": 1 }
              ]
            }
          }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-30m",
      "to": "now"
    }
  },
  "overwrite": true
}
